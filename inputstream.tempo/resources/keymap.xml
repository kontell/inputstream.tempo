<!-- inputstream.tempo keyboard/remote shortcuts for playback speed control.
     Auto-installed to special://userdata/keymaps/inputstream.tempo.xml
     Keys:
       ]          speed up one preset
       [          speed down one preset
       Backspace  reset to 1.0x
       Menu / s   pick a speed from a dialog (remote Menu button or keyboard s) -->
<keymap>
  <FullscreenVideo>
    <keyboard>
      <opensquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_down)</opensquarebracket>
      <closesquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_up)</closesquarebracket>
      <backspace>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_reset)</backspace>
      <menu>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,dialog)</menu>
      <s>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,dialog)</s>
    </keyboard>
  </FullscreenVideo>
  <Visualisation>
