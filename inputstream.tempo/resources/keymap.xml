<?xml version="1.0" encoding="UTF-8"?>
<!-- inputstream.tempo keyboard shortcuts for playback-speed control.
     Auto-installed to special://userdata/keymaps/inputstream.tempo.xml.

     Only keys unbound in the default Kodi keyboard map are used, so defaults
     (Up=SkipNext, Down=SkipPrevious, Menu=OSD, Backspace=Fullscreen, etc.)
     are preserved. speed.py bails out silently unless the calling addon has
     dropped special://temp/inputstream_tempo_active, so these keys are also
     no-ops during non-tempo playback.

     Keys:
       [   speed down one step
       ]   speed up   one step
       =   reset to 1.0x
       s   open the speed picker dialog -->
<keymap>
  <FullscreenVideo>
    <keyboard>
      <opensquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_down)</opensquarebracket>
      <closesquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_up)</closesquarebracket>
      <equals>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_reset)</equals>
      <s>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,dialog)</s>
    </keyboard>
  </FullscreenVideo>
  <Visualisation>
    <keyboard>
      <opensquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_down)</opensquarebracket>
      <closesquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_up)</closesquarebracket>
      <equals>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_reset)</equals>
      <s>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,dialog)</s>
    </keyboard>
  </Visualisation>
  <MusicOSD>
    <keyboard>
      <opensquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_down)</opensquarebracket>
      <closesquarebracket>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_up)</closesquarebracket>
      <equals>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,speed_reset)</equals>
      <s>RunScript(special://home/addons/inputstream.tempo/resources/lib/speed.py,dialog)</s>
    </keyboard>
  </MusicOSD>
</keymap>
