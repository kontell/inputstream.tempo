<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="inputstream.tempo"
  version="0.3.10"
  name="Inputstream Tempo"
  provider-name="konell">
  <requires>@ADDON_DEPENDS@</requires>
  <extension
    point="kodi.inputstream"
    name="tempo"
    extension=""
    tags="true"
    listitemprops="program_number|stream_mode|open_mode|manifest_type|default_url|is_realtime_stream|playback_as_live|programme_start_time|programme_end_time|catchup_url_format_string|catchup_url_near_live_format_string|catchup_buffer_start_time|catchup_buffer_end_time|catchup_buffer_offset|catchup_terminates|catchup_granularity|timezone_shift|default_programme_duration|programme_catchup_id|tempo|tempo_file|start_time"
    library_@PLATFORM@="@LIBRARY_FILENAME@" />
  <extension point="xbmc.service" library="resources/lib/runner.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-2.0-or-later</license>
    <summary lang="en_GB">InputStream client with audio tempo control (pitch-corrected playback speed)</summary>
    <description lang="en_GB">InputStream client based on FFmpeg with built-in audio tempo processing. Supports pitch-corrected playback speed from 0.5x to 100x for audiobooks and podcasts. Based on inputstream.ffmpegdirect.</description>
    <news>v0.3.10 Fix startup crash on Kodi builds bundling FFmpeg 6 (e.g. ENABLE_INTERNAL_FFMPEG=ON) for Opus/webm sources: matroska demuxer leaves the codec context's sample_rate / ch_layout / sample_fmt unset until the first packet decodes, so InitTempoProcessing now backfills from codecpar before BuildFilterGraph builds the abuffer. Also includes v0.3.9's VideoPlayer-OSD content-time tracking (dynamic ptsStart from popped packet pts/dispTime).</news>
  </extension>
</addon>
