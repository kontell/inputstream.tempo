<?xml version="1.0" encoding="UTF-8"?>
<addon
  id="inputstream.tempo"
  version="0.4.0"
  name="Inputstream Tempo"
  provider-name="konell">
  <requires>@ADDON_DEPENDS@</requires>
  <extension
    point="kodi.inputstream"
    name="tempo"
    extension=""
    tags="true"
    listitemprops="program_number|stream_mode|open_mode|manifest_type|default_url|is_realtime_stream|playback_as_live|programme_start_time|programme_end_time|catchup_url_format_string|catchup_url_near_live_format_string|catchup_buffer_start_time|catchup_buffer_end_time|catchup_buffer_offset|catchup_terminates|catchup_granularity|timezone_shift|default_programme_duration|programme_catchup_id|tempo|tempo_file|start_time|live_ramp_enabled|live_min_lead_sec|live_ramp_rate"
    library_@PLATFORM@="@LIBRARY_FILENAME@" />
  <extension point="xbmc.service" library="resources/lib/runner.py"/>
  <extension point="xbmc.addon.metadata">
    <platform>@PLATFORM@</platform>
    <license>GPL-2.0-or-later</license>
    <summary lang="en_GB">InputStream client with audio tempo control (pitch-corrected playback speed)</summary>
    <description lang="en_GB">InputStream client based on FFmpeg with built-in audio tempo processing. Supports pitch-corrected playback speed from 0.5x to 100x for audiobooks and podcasts. Based on inputstream.ffmpegdirect.</description>
    <news>v0.4.0 Live-edge tempo ramp. For live streams with a DVR window, tempo is automatically ramped down to 1.0x as the playhead approaches the live edge, so you can't outrun real time. Configurable via listitem props.</news>
  </extension>
</addon>
